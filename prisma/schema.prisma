datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  STAFF
  OWNER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CouponDiscountType {
  PERCENT
  FLAT
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model User {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  name              String?
  email             String             @unique
  passwordHash      String?
  phone             String?
  role              Role               @default(CUSTOMER)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  couponRedemptions CouponRedemption[]
  activityEvents    ActivityEvent[]

  @@index([role])
}

model Address {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Category {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  products     Product[]

  @@index([displayOrder])
}

model Product {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String           @unique
  description      String
  categoryId       String           @db.ObjectId
  category         Category         @relation(fields: [categoryId], references: [id])
  medium           String
  dimensions       String
  careInstructions String?
  tags             String?
  featured         Boolean          @default(false)
  status           ProductStatus    @default(ACTIVE)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  variants         ProductVariant[]
  images           ProductImage[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
}

model ProductVariant {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  productId  String      @db.ObjectId
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  frame      String
  price      Int
  mrp        Int?
  sku        String      @unique
  stock      Int         @default(0)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productId    String   @db.ObjectId
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
}

model Order {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber       String               @unique
  userId            String?              @db.ObjectId
  user              User?                @relation(fields: [userId], references: [id])
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   String
  orderNotes        String?
  subtotal          Int
  discount          Int                  @default(0)
  shippingFee       Int                  @default(0)
  tax               Int                  @default(0)
  total             Int
  status            OrderStatus          @default(PLACED)
  paymentMethod     PaymentMethod        @default(ONLINE)
  paymentStatus     PaymentStatus        @default(CREATED)
  courierName       String?
  trackingNumber    String?
  internalNotes     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  items             OrderItem[]
  payments          Payment[]
  refunds           Refund[]
  statusHistory     OrderStatusHistory[]
  couponRedemptions CouponRedemption[]

  @@index([customerEmail])
  @@index([customerPhone])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  orderId       String         @db.ObjectId
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String         @db.ObjectId
  product       Product        @relation(fields: [productId], references: [id])
  variantId     String         @db.ObjectId
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  titleSnapshot String
  sizeSnapshot  String
  frameSnapshot String
  priceSnapshot Int
  quantity      Int
  subtotal      Int

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId           String        @db.ObjectId
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("razorpay")
  providerOrderId   String?
  providerPaymentId String?
  amount            Int
  fee               Int           @default(0)
  status            PaymentStatus @default(CREATED)
  method            String?
  failureReason     String?
  rawResponse       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}

model Refund {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId          String   @db.ObjectId
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId        String?
  amount           Int
  reason           String
  status           String   @default("SUCCESS")
  providerRefundId String?
  createdAt        DateTime @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String      @db.ObjectId
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String      @default("SYSTEM")
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Coupon {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  code          String             @unique
  description   String?
  discountType  CouponDiscountType @default(PERCENT)
  discountValue Int
  minOrderValue Int                @default(0)
  maxDiscount   Int?
  usageLimit    Int?
  usageCount    Int                @default(0)
  expiresAt     DateTime?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  redemptions   CouponRedemption[]
}

model CouponRedemption {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  couponId       String   @db.ObjectId
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  orderId        String   @db.ObjectId
  order          Order    @relation(fields: [orderId], references: [id])
  userId         String?  @db.ObjectId
  user           User?    @relation(fields: [userId], references: [id])
  discountAmount Int
  createdAt      DateTime @default(now())

  @@index([couponId])
  @@index([orderId])
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ContactMessage {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String
  phone           String?
  subject         String
  message         String
  status          InquiryStatus @default(NEW)
  adminReplyNotes String?
  createdAt       DateTime      @default(now())

  @@index([status])
}

model CustomOrderRequest {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String
  phone             String
  medium            String?
  dimensions        String?
  description       String
  budget            String?
  referenceImageUrl String?
  status            InquiryStatus @default(NEW)
  adminReplyNotes   String?
  createdAt         DateTime      @default(now())

  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ActivityEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventType String
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  adminUserId String?
  adminEmail  String
  action      String
  entity      String
  entityId    String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}

model SiteSettings {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  key                    String   @unique @default("default")
  businessName           String   @default("SHREENATH ART WORK")
  address                String   @default("Opposite Temple Gate, Nathdwara, Rajasthan 313301")
  phone                  String   @default("9079901405")
  email                  String   @default("shreenathartwork@gmail.com")
  openingHours           String   @default("Monday to Sunday: 9:00 AM to 8:30 PM")
  instagramUrl           String?
  facebookUrl            String?
  freeShippingThreshold  Int      @default(500000)
  standardShippingCharge Int      @default(25000)
  gstEnabled             Boolean  @default(true)
  gstRatePercent         Int      @default(12)
  codEnabled             Boolean  @default(true)
  paymentModeDisplay     String   @default("Razorpay Secure (UPI, Cards, Netbanking)")
  announcementBarText    String?
  announcementBarActive  Boolean  @default(false)
  policyTerms            String?
  policyPrivacy          String?
  policyShipping         String?
  updatedAt              DateTime @updatedAt
}
